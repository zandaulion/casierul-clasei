# Copy to .env and replace these placeholders before starting Compose.
# Use an HTTPS origin for other devices; the HTTP setting is for a local trial only.
PUBLIC_BASE_URL=https://cashier.example.invalid
ADMIN_TOKEN=
COOKIE_SECURE=true
# Optional host-side loopback port; PUBLIC_BASE_URL must use the same port in a local trial.
CASIERUL_PORT=8018
